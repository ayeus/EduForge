# ── Database (Postgres) ─────────────────────────────────────────
# Local: docker run -d --name eduforge-pg -e POSTGRES_USER=eduforge -e POSTGRES_PASSWORD=eduforge -e POSTGRES_DB=eduforge -p 54329:5432 postgres:17-alpine
# Production: Neon / Supabase / RDS connection string (use the pooled URL on serverless)
DATABASE_URL=postgres://eduforge:eduforge@localhost:54329/eduforge
# Direct (non-pooled) connection for realtime LISTEN/NOTIFY. Neon sets this for you.
# Leave empty locally; without it in production, realtime falls back to polling.
DATABASE_URL_UNPOOLED=

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── File storage (S3) ───────────────────────────────────────────
# Leave S3_BUCKET_NAME empty in development to store uploads on local disk (.uploads/).
# Required in production (Vercel has no persistent disk).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# ── Live classes (Mux) ──────────────────────────────────────────
# Set automatically by the Vercel Mux integration, or create an access token in Mux.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Optional: signed playback so only enrolled students can watch (Mux → Settings → Signing keys)
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
# Optional: Mux webhook pointing at /api/webhooks/mux for instant status changes
MUX_WEBHOOK_SECRET=
# Optional: "true" creates free, watermarked 5-minute test streams
MUX_TEST_STREAMS=

# ── AI tutor (optional) ─────────────────────────────────────────
# Vercel AI Gateway key. On Vercel, OIDC auth works automatically once AI Gateway is enabled.
AI_GATEWAY_API_KEY=
# Any provider/model id supported by AI Gateway
AI_TUTOR_MODEL=anthropic/claude-haiku-5.5
